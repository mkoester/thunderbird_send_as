#!/usr/bin/env bash
# Render the extension's UI pages (options + both prompt popups) to PNGs in
# light and pinned-dark theme using a headless Chromium-family browser —
# review CSS changes without installing the XPI.
#
# - Output: screenshots/ in the repo root (gitignored)
# - Browser: $SCREENSHOT_BROWSER, or the first of chromium, chromium-browser,
#   google-chrome, brave found on PATH
# - `hidden` attributes are stripped in the rendered copies so conditional
#   elements (status messages, setup hint) are visible for styling review
# - Pages run without the messenger API, so dynamic content is missing and a
#   console error on the options page is expected; only styling is reviewable

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
OUT_DIR="$REPO_DIR/screenshots"

BROWSER="${SCREENSHOT_BROWSER:-}"
if [ -z "$BROWSER" ]; then
    for candidate in chromium chromium-browser google-chrome brave; do
        if command -v "$candidate" > /dev/null 2>&1; then
            BROWSER="$candidate"
            break
        fi
    done
fi
if [ -z "$BROWSER" ]; then
    echo "Error: no Chromium-family browser found; set SCREENSHOT_BROWSER" >&2
    exit 1
fi

TEMP_DIR=$(mktemp -d -t send-as-alias-shots.XXXXXXXXXX)
trap 'rm -rf "$TEMP_DIR"' EXIT

cp -r "$REPO_DIR/options" "$REPO_DIR/popup" "$REPO_DIR/theme" "$REPO_DIR/icons" "$TEMP_DIR/"

mkdir -p "$OUT_DIR"

shoot() {
    local page="$1" width="$2" height="$3" name="$4"
    local html="$TEMP_DIR/$page"
    local dark_html="${html%.html}-dark.html"

    sed -i 's/ hidden>/>/' "$html"
    sed 's/<html>/<html data-theme="dark">/' "$html" > "$dark_html"

    "$BROWSER" --headless=new --disable-gpu --window-size="$width,$height" \
        --screenshot="$OUT_DIR/$name-light.png" "file://$html" 2> /dev/null
    "$BROWSER" --headless=new --disable-gpu --window-size="$width,$height" \
        --screenshot="$OUT_DIR/$name-dark.png" "file://$dark_html" 2> /dev/null
}

shoot options/options.html 980 900 options
shoot popup/alias-prompt.html 550 520 alias-prompt
shoot popup/identity-prompt.html 550 560 identity-prompt

echo "✓ Screenshots written to $OUT_DIR (browser: $BROWSER)"
ls -1 "$OUT_DIR"
